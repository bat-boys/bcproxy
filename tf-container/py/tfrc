/set log_prefix=
/set pedantic=off
/histsize 10000

; from kbd-xterm.tf
/def -i key_up = /dokey recallb
/def -i key_down = /dokey recallf
/def -i key_nkpEnt = /dokey newline
/def -i -b'^[[7~' = /dokey home
/def -i -b'^[[8~' = /dokey end
/def -i -b'^[Od' = /dokey wleft
/def -i -b'^[Oc' = /dokey wright
/def -i key_tab = /complete

/def WORLDFILE = worlds/worlds.tf
/loadworld

/load py/gag-bcproxy-tags.tf
/python_load py.global_state
/python_load py.chat
/python_load py.binds
/python_load py.party
/python_load py.prefix_trigger
/python_load py.typo_messages

;; load per-character commands from tfrc-<world name>
/hook LOGIN = /load py/tfrc-%{1}%;/python_call py.global_state.on_login

/def -h`PROMPT PROMPT:>` prompt_hook = /test prompt("")
